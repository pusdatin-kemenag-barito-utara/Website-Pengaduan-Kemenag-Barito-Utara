# ==========================================
# SI-GESIT Kemenag Barito Utara — .gitignore
# ==========================================

# Dependencies (Root, Frontend, & Backend)
node_modules/
**/node_modules/
.pnpm-store/
.npm/

# Astro & Frontend Build Output
dist/
**/dist/
.astro/
**/.astro/
*.tsbuildinfo
.output/

# Go Backend Build & Binaries
backend/bin/
backend/tmp/
bin/
tmp/
api
backend/api
backend/cmd/api/api
backend/cmd/api/api.exe
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Environment Variables & Secrets (Semua Direktori & Subdirektori)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.cert

# Lighthouse, Coverage & Test Reports
report-*.json
report-*.html
coverage.out
coverage.html
.nyc_output/

# Logs & Runtime Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS Specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDE, Editor & Tooling
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.gemini/
.agents/