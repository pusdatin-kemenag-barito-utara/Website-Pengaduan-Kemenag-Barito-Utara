# ==========================================
# SI-GESIT Kemenag Barito Utara — .gitignore
# ==========================================

# Dependencies
node_modules/
.pnpm-store/
.npm/

# Astro & Frontend Build
dist/
frontend/dist/
.astro/
frontend/.astro/
*.tsbuildinfo

# Lighthouse & Test Reports
report-*.json
report-*.html
coverage.out
coverage.html

# Go Backend Build & Binaries
backend/bin/
backend/tmp/
bin/
tmp/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Environment Variables & Secrets
.env
.env.local
.env.*.local
.env.production
.env.development
!.env.example
*.pem
*.key
*.cert

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS Specific
.DS_Store
Thumbs.db

# IDE & Editor
.idea/
.vscode/*
!.vscode/settings.json
*.sublime-workspace
*.sublime-project