# ===================================================
# SI-GESIT Kemenag Barito Utara — Comprehensive .gitignore
# ===================================================

# 1. Dependencies & Package Managers (Root & Submodules)
node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm-store/
.npm/
**/.npm/
.yarn/
**/.yarn/
.yarn-cache/
**/.yarn-cache/

# 2. Local Scripts & Helper Automation (Excluded from Git)
scripts/
**/scripts/
scratch/
**/scratch/
*.sh.local
*.ps1.local
*.bat.local

# 3. Astro & Frontend Build Output
dist/
**/dist/
.astro/
**/.astro/
.output/
**/.output/
.vite/
**/.vite/
*.tsbuildinfo
**/*.tsbuildinfo

# 4. Go Backend Build & Executables
backend/bin/
backend/tmp/
bin/
**/bin/
tmp/
**/tmp/
api
backend/api
backend/cmd/api/api
backend/cmd/api/api.exe
**/api
**/api.exe
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.prof

# 5. Environment Variables & Secret Files (Infisical Cloud Centralized)
.env
.env.*
**/.env
**/.env.*
!.env.vault
.infisical/
**/.infisical/
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*

# 6. Database Backups, Dumps & Local SQLite
*.sql.gz
*.sql.tar.gz
*.bak
*.dump
*.sqlite
*.sqlite3
*.db

# 7. Test Reports, Coverage & Build Caches
report-*.json
report-*.html
coverage.out
coverage.html
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/
.turbo/
**/.turbo/
.cache/
**/.cache/

# 8. Logs & Runtime Debug
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 9. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# 10. IDE, Editor & Agent Artifacts
.idea/
**/.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.gemini/
**/.gemini/
.agents/
**/.agents/