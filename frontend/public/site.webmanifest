  "shortcuts": [
    {
      "name": "Kirim Pengaduan Baru",
      "short_name": "Buat Laporan",
      "description": "Sampaikan pengaduan, saran, atau aspirasi ke Kemenag Barito Utara",
      "url": "/#form",
      "icons": [{ "src": "/android-chrome-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Lacak Status Tiket",
      "short_name": "Cek Tiket",
      "description": "Pantau tindak lanjut nomor tiket pengaduan Anda secara real-time",
      "url": "/?action=track",
      "icons": [{ "src": "/android-chrome-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Konsultasi WhatsApp PTSP",
      "short_name": "Chat PTSP",
      "description": "Hubungi petugas Helpdesk PTSP Kemenag Barito Utara via WhatsApp",
      "url": "/?action=helpdesk",
      "icons": [{ "src": "/android-chrome-192x192.png", "sizes": "192x192" }]
    }
  ],
  "categories": ["government", "productivity", "utilities", "social"]
