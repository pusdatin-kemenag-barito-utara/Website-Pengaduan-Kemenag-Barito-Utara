{
  "name": "SI-GESIT — Pengaduan Kemenag Barito Utara",
  "short_name": "SI-GESIT",
  "description": "Sistem Informasi Gagasan, Evaluasi, Saran, Informasi dan Tanggapan resmi Kantor Kementerian Agama Kabupaten Barito Utara",
  "start_url": "/",
  "id": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f0fdf4",
  "theme_color": "#047857",
  "orientation": "portrait-primary",
  "lang": "id-ID",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/favicon-16x16.png",
